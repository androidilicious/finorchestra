# Optional. Without it, FRED vintages are fetched from the ALFRED graph endpoint.
FRED_API_KEY=

# Any OpenAI-compatible chat-completions endpoint. Examples:
#   OpenAI:              base_url=https://api.openai.com/v1            model=gpt-4o-mini
#   Ollama (local):      base_url=http://localhost:11434/v1            model=qwen2.5:3b   (key can be anything)
#   Cloudflare Workers AI: base_url=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1  model=@cf/meta/llama-3.1-8b-instruct
#   Amazon Bedrock:      via an OpenAI-compatible gateway (e.g. Bedrock Access Gateway or LiteLLM proxy)
#   OpenRouter:          base_url=https://openrouter.ai/api/v1         model=<provider/model>
FINORCHESTRA_LLM_API_KEY=ollama
